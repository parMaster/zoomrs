{
  "extraKnownMarketplaces": {
    "parmaster-claude-dlc": {
      "source": {
        "source": "github",
        "repo": "parmaster/claude-dlc"
      }
    }
  },
  "enabledPlugins": {
    "planning@parmaster-claude-dlc": true,
    "brainstorm@parmaster-claude-dlc": true,
    "style@parmaster-claude-dlc": true,
    "git-tools@parmaster-claude-dlc": true,
    "global-rules@parmaster-claude-dlc": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
